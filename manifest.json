{
  "manifest_version": 3,
  "name": "酒店降价追踪",
  "version": "0.1.0",
  "description": "记录酒店可见房价，手动检查降价。",
  "permissions": ["storage"],
  "host_permissions": ["https://*.booking.com/*"],
  "background": {"service_worker": "src/background.js"},
  "action": {"default_popup": "src/popup/popup.html"},
  "icons": {"16":"icons/icon16.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "content_scripts": [{"matches":["https://*.booking.com/hotel/*"],"js":["src/lib/price.js","src/content/selectors.js","src/content/content.js"],"run_at":"document_idle"}]
}
